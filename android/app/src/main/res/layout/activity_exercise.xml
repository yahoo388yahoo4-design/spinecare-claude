<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sc_bg">

    <androidx.camera.view.PreviewView
        android:id="@+id/preview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <com.spinecare.app.OverlayView
        android:id="@+id/overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tvExercise"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="7"
        android:ellipsize="end"
        android:padding="12dp"
        android:textColor="@color/sc_text"
        android:textSize="16sp"
        android:background="#990B1220"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tvCue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:textColor="@color/sc_warn"
        android:textSize="15sp"
        android:background="#CC0B1220"
        app:layout_constraintBottom_toTopOf="@id/tvMetrics"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tvMetrics"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:textColor="@color/sc_muted"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:background="#CC0B1220"
        app:layout_constraintBottom_toTopOf="@id/btnRow2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <LinearLayout
        android:id="@+id/btnRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="@color/sc_surface"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button android:id="@+id/btnStart" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="Start"/>
        <Button android:id="@+id/btnStop" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="Stop &amp; Save"/>
        <Button android:id="@+id/btnMode" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="Mode: On-device"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnRow2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="@color/sc_surface"
        app:layout_constraintBottom_toTopOf="@id/btnRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button android:id="@+id/btnFlip" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="Flip camera"/>
        <Button android:id="@+id/btnRec" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="Record: Off"/>
        <Button android:id="@+id/btnCalib" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="Recalibrate"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tvReps"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/sc_ok"
        android:textSize="42sp"
        android:textStyle="bold"
        android:shadowColor="#000" android:shadowRadius="6"
        app:layout_constraintTop_toBottomOf="@id/tvExercise"
        app:layout_constraintEnd_toEndOf="parent"
        android:padding="16dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
